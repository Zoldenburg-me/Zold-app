{
  "$description": "Zold UI v2 design tokens with the ARK values (design/ark/DESIGN.md). Dark-first. Source of truth for tokens.css. The reference screens in ../screens predate ARK.",
  "color": {
    "bg":              { "value": "#0b0b0c", "use": "Page background. Never pure #000." },
    "surface":         { "value": "#131314", "use": "Plain raised surface" },
    "sunk":            { "value": "#101011", "use": "Sunk panels (code blocks)" },
    "field":           { "value": "#101011", "use": "Input and select fill" },
    "sheet":           { "value": "#1a1a1c", "use": "Bottom sheets and dialogs" },
    "card":            { "value": "#131314", "use": "Cards, list groups, summaries. Flat: ARK has no gradients" },
    "ghost":           { "value": "rgba(237,230,214,.03)", "use": "Secondary button fill, neutral tiles" },
    "line":            { "value": "#2a2926", "use": "Card borders, row dividers" },
    "line-strong":     { "value": "#3a3833", "use": "Input borders, secondary button borders" },
    "line-hover":      { "value": "#5c574e", "use": "Secondary button border on hover" },
    "text":            { "value": "#ede6d6", "use": "Body text (ivory)" },
    "heading":         { "value": "#f6f1e7", "use": "Headings and big figures" },
    "dim":             { "value": "#9c9484", "use": "Secondary text, labels, placeholders. The lowest allowed text colour (contrast)." },
    "pink":            { "value": "#ed188d", "use": "Brand accent: ONE primary action per screen, focus ring, progress" },
    "pink-hover":      { "value": "#ff2d9e", "use": "Primary button hover" },
    "pink-link":       { "value": "#f06bb4", "use": "Inline links" },
    "pink-link-hover": { "value": "#ff8fc4", "use": "Inline link hover" },
    "pink-soft":       { "value": "#e8a9cd", "use": "Text on pink tint" },
    "pink-tint":       { "value": "rgba(237,24,141,.08)", "use": "Selected pill, brand tile fill" },
    "pink-border":     { "value": "rgba(237,24,141,.35)", "use": "Selected pill, brand tile border" },
    "mint":            { "value": "#6fa585", "use": "Money in, success. RECEIVED, ACTIVE, APPROVED. ARK green" },
    "mint-tint":       { "value": "rgba(111,165,133,.1)" },
    "mint-border":     { "value": "rgba(111,165,133,.28)" },
    "amber":           { "value": "#d98e4a", "use": "Warnings, test mode, Soon, IN REVIEW, NEEDS FIXING" },
    "amber-tint":      { "value": "rgba(217,142,74,.08)" },
    "amber-border":    { "value": "rgba(217,142,74,.32)" },
    "red":             { "value": "#d27468", "use": "Failed, destructive" },
    "scrim":           { "value": "rgba(5,5,6,.7)", "use": "Behind sheets and dialogs" }
  },
  "font": {
    "sans":      { "value": "Inter, system-ui, sans-serif", "use": "Everything. Self-hosted in services/api/public/vendor/fonts. Kept on purpose as the brand face, see RULES.md." },
    "mono":      { "value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, monospace", "use": "IBAN, BIC, wallet addresses and reference codes only" },
    "icons-app": { "value": "Material Symbols Rounded", "use": "App icons (ligatures), weight 400, unfilled" },
    "icons-web": { "value": "Phosphor (subset)", "use": "Landing page icons" }
  },
  "type": {
    "display":   { "size": 52,   "weight": 600, "tracking": "-0.05em",  "line": 1,    "use": "Balance and big amounts. Currency sign and cents at 30px in dim" },
    "title":     { "size": 34,   "weight": 600, "tracking": "-0.045em", "line": 1.05, "use": "Onboarding h1, text-wrap: balance" },
    "title-sm":  { "size": 32,   "weight": 600, "tracking": "-0.045em", "line": 1.05, "use": "Screen h1 on tab and result screens" },
    "topbar":    { "size": 17,   "weight": 600, "tracking": "-0.02em",  "use": "h1 inside the top bar of a pushed screen" },
    "section":   { "size": 20,   "weight": 600, "tracking": "-0.03em",  "use": "Sheet and dialog h2" },
    "body":      { "size": 15,   "weight": 400, "line": 1.6, "use": "Ledes and paragraphs, colour dim" },
    "row-title": { "size": 14.5, "weight": 500, "use": "List row title, one line with ellipsis" },
    "row-sub":   { "size": 12.5, "weight": 400, "line": 1.4, "use": "List row subline, dim" },
    "label":     { "size": 14,   "weight": 500, "use": "Form labels" },
    "input":     { "size": 16,   "weight": 400, "use": "Inputs. Never below 16px on phones (iOS zooms)." },
    "eyebrow":   { "size": 11,   "weight": 600, "tracking": "0.13em", "case": "uppercase", "use": "Group labels only (RECENT ACTIVITY). Rationed." },
    "tag":       { "size": 10,   "weight": 600, "tracking": "0.06em", "case": "uppercase", "use": "Status pills" },
    "figures":   { "feature": "font-variant-numeric: tabular-nums", "use": "Every amount and count (.z-fig)" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "10": 40, "12": 48,
             "screen-gutter": 16, "desk-gutter": 40, "section-gap": 20, "form-gap": 18 },
  "radius": { "control": 6, "sm": 6, "md": 6, "note": 14, "card": 14, "qr": 20, "sheet": 20, "pill": 999, "$use": "control: buttons, inputs, segmented controls, filter pills. pill: tags, badges and progress tracks only" },
  "size": {
    "phone-width": 412, "desktop-width": 1440, "sidebar": 256,
    "touch-min": 44, "input-h": 52, "input-h-compact": 48, "button-h": 56, "button-h-secondary": 52, "row-min-h": 64,
    "icon-tile": 40, "avatar": 40, "topbar-h": 60, "bottom-nav-h": 76
  },
  "shadow": {
    "sheet": "0 -30px 80px rgba(0,0,0,.6)",
    "dialog": "0 30px 80px rgba(0,0,0,.6)"
  },
  "motion": {
    "hover": "background-color .15s ease, border-color .15s ease, color .15s ease",
    "press": "transform: translateY(1px) over .1s ease",
    "currency-cycle": "10s loop, 2.5s per word, fade plus 0.22em slide (landing headline only)",
    "reduced-motion": "All transitions and animations off. The currency headline stays on 'euro'."
  },
  "breakpoint": { "phone-max": 760, "desktop-min": 1024 },
  "focus": { "ring": "2px solid #ed188d", "offset": "2px", "selector": ":focus-visible only" }
}
