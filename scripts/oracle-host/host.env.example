# The Oracle host's settings: OWNER INPUT. Copy to /etc/zold-host/host.env on
# the host (root:root, mode 600) and fill every CHANGE_ME. Never commit the
# filled file; keep an age-encrypted copy off the host (design §7.1). Plain
# NAME=value lines only, no `export`, `declare`, `readonly`, `set` or
# `eval`: the scripts keep these values unexported, so no runuser child
# (pg-testnet, say) inherits another deployment's keys.
# provision.sh refuses while any value it needs is unset or CHANGE_ME.

# The tenancy's Object Storage namespace (OCI console: Tenancy details).
OCI_NAMESPACE=CHANGE_ME
# Public age key the daily dumps are encrypted to. The private key is never
# on the host.
OWNER_AGE_RECIPIENT=CHANGE_ME
# HTTPS endpoint (https:// only) that takes an alert's text as its POST body (an ntfy topic,
# say). The reconciler only logs; this is the host's own channel.
ALERT_URL=CHANGE_ME

# --- mainnet ------------------------------------------------------------------
# Which pgBackRest repositories to configure: "1 2" normally; only the
# reachable ones during a region loss (§7.1 step 3).
MAINNET_REPOS="1 2"
MAINNET_REPO1_REGION=CHANGE_ME          # the host's region, e.g. eu-frankfurt-1
MAINNET_REPO1_BUCKET=zold-pgbackrest-mainnet-fra
MAINNET_REPO2_REGION=CHANGE_ME          # a second EU region, e.g. eu-amsterdam-1
MAINNET_REPO2_BUCKET=zold-pgbackrest-mainnet-ams
# A tenancy limited to one region: repo2 on Cloudflare R2 instead, with the
# region "auto" and an R2 token scoped to this bucket (docs/oracle-host.md).
# MAINNET_REPO2_ENDPOINT=<account id>.r2.cloudflarestorage.com
# MAINNET_REPO2_S3_KEY=
# MAINNET_REPO2_S3_SECRET=
# Customer secret key of an OCI user whose policy covers these two buckets only.
MAINNET_S3_KEY=CHANGE_ME
MAINNET_S3_SECRET=CHANGE_ME
# The repository passphrase (repo-cipher-pass). The owner keeps the off-host
# copy: without it there is no restore.
MAINNET_CIPHER_PASS=CHANGE_ME
# The dump bucket (second region, 14-day time-bound retention rule, 30-day
# lifecycle delete) and a key that may create and read objects only.
MAINNET_DUMP_REGION=CHANGE_ME
MAINNET_DUMP_BUCKET=zold-dumps-mainnet
MAINNET_DUMP_KEY=CHANGE_ME
MAINNET_DUMP_SECRET=CHANGE_ME
# The dump bucket on R2 (region "auto"; a 14-day bucket lock rule):
# MAINNET_DUMP_ENDPOINT=<account id>.r2.cloudflarestorage.com

# --- testnet (its own user, buckets and passphrase) ---------------------------
TESTNET_REPOS="1 2"
TESTNET_REPO1_REGION=CHANGE_ME
TESTNET_REPO1_BUCKET=zold-pgbackrest-testnet-fra
TESTNET_REPO2_REGION=CHANGE_ME
TESTNET_REPO2_BUCKET=zold-pgbackrest-testnet-ams
TESTNET_S3_KEY=CHANGE_ME
TESTNET_S3_SECRET=CHANGE_ME
TESTNET_CIPHER_PASS=CHANGE_ME
TESTNET_DUMP_REGION=CHANGE_ME
TESTNET_DUMP_BUCKET=zold-dumps-testnet
TESTNET_DUMP_KEY=CHANGE_ME
TESTNET_DUMP_SECRET=CHANGE_ME

# --- the hub (§7.2): S7's starting values, tuned under real load in S9 --------
HUB_TESTNET=0            # 1: a hub database in the testnet cluster too
HUB_SIZE_ALERT_MB=1024   # alert when hub passes this
HUB_SIZE_STOP_MB=2048    # stop the hub (CONNECTION LIMIT 0) past this

# Each deployment's chain addresses are /etc/zold/<deployment>.deployments.json
# (root:root 600): the deployments.json the lease writes from its environment
# variable. deploy.sh copies it into every release; without it nothing deploys.
# Each API's own environment is /etc/zold/<deployment>.env (root:root 600),
# the deployment's .env as on the lease, plus:
#   STORE_BACKEND=postgres            (S8, the cut-over)
#   DATABASE_URL=postgresql://zold_app@/zold?host=/run/postgresql-mainnet&port=5432
#   TRANSF_DB_PATH=/var/lib/zold-mainnet/db.json
#   TRANSF_API_PORT=3000              (testnet 3001; cloudflared points at it)
