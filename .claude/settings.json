{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.backup-*)",
      "Read(**/.private/**)",
      "Read(!**/.private/pentest/**)",
      "Read(/data/*.json)",
      "Edit(**/.env)",
      "Edit(/data/*.json)",
      "Bash(less .env*)",
      "Bash(grep * .env*)",
      "Bash(printenv*)"
    ]
  }
}
